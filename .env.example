# ЛР №3. Скопируйте в .env. Это заполнители, настоящих секретов здесь нет.
# Замените пароль случайной hex-строкой (только 0-9a-f): её не нужно URL-кодировать.
POSTGRES_PASSWORD=replace_with_random_hex
# Используется локальными npm-командами, не контейнером приложения.
DATABASE_URL=postgresql://stockflow:replace_with_random_hex@127.0.0.1:5432/stockflow
APP_PORT=3000
# На VM укажите её адрес host-only: например 192.168.56.11 для TEST.
APP_BIND_ADDRESS=127.0.0.1
